@model Models.PublicSite.BlogPostPage
@using Helpers
@using System.Linq
@{
    Layout = null;

    var post = Model.Post!;
    var contact = Model.ContactInfo;
    var dir = WritingDirection.GetHtmlDir(Model.CurrentLanguage.Code);
    var lang = Model.CurrentLanguage.Code;
    var homePath = SiteRoutes.BuildMenuPath("/", lang);
    var blogPath = SiteRoutes.BuildMenuPath("/blog", lang);
    var privacyPath = SiteRoutes.BuildPrivacyPolicyPath(lang);
    var termsPath = SiteRoutes.BuildTermsOfUsePath(lang);
    var contactHref = homePath == "/" ? "/#contact" : homePath + "#contact";
    var pageTitle = post.SeoTitle ?? post.Name;

    string DigitsOnly(string? value) => string.Concat((value ?? string.Empty).Where(char.IsDigit));

    string? BlogImageSrc(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        return imageUrl.StartsWith('/')
            ? Url.Content("~" + imageUrl)
            : Url.Content("~/images/blog/" + imageUrl);
    }

    var phoneDigits = DigitsOnly(contact?.Phone);
    var whatsAppDigits = DigitsOnly(contact?.WhatsApp);
    var email = contact?.Email;
    var phoneDisplay = contact?.Phone;
    var imageSrc = BlogImageSrc(post.ImageUrl);
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(post.MetaDescription))
    {
        <meta name="description" content="@post.MetaDescription">
    }
    @if (!string.IsNullOrWhiteSpace(post.MetaRobots))
    {
        <meta name="robots" content="@post.MetaRobots">
    }
    @if (!string.IsNullOrWhiteSpace(post.OgTitle))
    {
        <meta property="og:title" content="@post.OgTitle">
    }
    @if (!string.IsNullOrWhiteSpace(post.OgDescription))
    {
        <meta property="og:description" content="@post.OgDescription">
    }
    @if (!string.IsNullOrWhiteSpace(post.OgImage))
    {
        <meta property="og:image" content="@post.OgImage">
    }
    @if (!string.IsNullOrWhiteSpace(post.OgType))
    {
        <meta property="og:type" content="@post.OgType">
    }
    @if (!string.IsNullOrWhiteSpace(post.OgUrl))
    {
        <meta property="og:url" content="@post.OgUrl">
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/Styles/StyleSheetRTL.css" rel="stylesheet" />
</head>
<body>

    <div class="site-sticky">
    <!-- ============== TOP BAR ============== -->
    <div class="topbar">
        <div class="topbar-inner">
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <a href="mailto:@email" class="topbar-item" title="@email">
                    <img src="~/images/email.png" alt="" class="icon-img">
                    <span class="label">@email</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(phoneDisplay))
            {
                <a href="tel:@phoneDigits" class="topbar-item" title="@phoneDisplay">
                    <img src="~/images/phone.png" alt="" class="icon-img">
                    <span class="label">@phoneDisplay</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(whatsAppDigits))
            {
                <a href="https://wa.me/@whatsAppDigits" target="_blank" rel="noopener" class="topbar-item" title="@T["WhatsApp"]">
                    <img src="~/images/whatsapp.png" alt="" class="icon-img">
                    <span class="label">@T["WhatsApp"]</span>
                </a>
            }
        </div>
    </div>

    <!-- ============== HEADER ============== -->
    <header class="site-header">
        <div class="header-inner">
            <a href="@homePath" class="logo">
                <img src="~/images/Logo.png" alt="@T["FirmName"]" class="logo-img">
            </a>

            <nav class="main-nav" id="mainNav">
                <ul>
                    @foreach (var item in Model.Menu.Items.Reverse())
                    {
                        var hasSubMenu = item.SubMenu.Count > 0;
                        var isActive = SiteRoutes.IsBlogUrl(item.Url)
                            || item.SubMenu.Any(sub => SiteRoutes.IsBlogUrl(sub.Url));
                        <li class="@(hasSubMenu ? "has-dropdown" : null)">
                            @if (hasSubMenu)
                            {
                                <span class="nav-parent @(isActive ? "active" : null)">
                                    @item.Title
                                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                                </span>
                            }
                            else
                            {
                                <a href="@SiteRoutes.BuildMenuPath(item.Url, lang)"
                                   class="@(isActive ? "active" : null)">
                                    @item.Title
                                </a>
                            }
                            @if (hasSubMenu)
                            {
                                <ul class="dropdown">
                                    @foreach (var subItem in item.SubMenu)
                                    {
                                        <li>
                                            <a href="@SiteRoutes.BuildMenuPath(subItem.Url, lang)"
                                               class="@(SiteRoutes.IsBlogUrl(subItem.Url) ? "active" : null)">
                                                @subItem.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </nav>

            <a href="@contactHref" class="btn btn-primary">@T["Contact"]</a>

            <button class="nav-toggle" id="navToggle" aria-label="@T["OpenMenu"]" aria-expanded="false" aria-controls="mainNav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
        </div>
    </header>
    </div>

    <main>

        <!-- ============== PAGE TITLE HERO ============== -->
        <section class="page-hero">
            <div class="container">
                <h1>@T["BlogTitle"]</h1>
                <p class="breadcrumb">@T["BlogHeroText"]</p>
            </div>
        </section>

        <!-- ============== ARTICLE ============== -->
        <section class="practice-detail">
            <div class="practice-detail-grid container">

                <article class="practice-detail-main">
                    @if (!string.IsNullOrWhiteSpace(imageSrc))
                    {
                        <img src="@imageSrc" alt="@post.Name" class="detail-image">
                    }
                    else
                    {
                        <div class="detail-image" aria-hidden="true"></div>
                    }

                    <h2>@post.Name</h2>

                    @if (!string.IsNullOrWhiteSpace(post.Body))
                    {
                        <div class="blog-article-body">
                            @Html.Raw(post.Body)
                        </div>
                    }

                    <div class="blog-detail-footer"></div>
                </article>

                <aside class="practice-sidebar">
                    @if (Model.LatestPosts.Count > 0)
                    {
                        <div class="latest-articles">
                            <h3>@T["LatestArticles"]</h3>
                            @foreach (var latest in Model.LatestPosts)
                            {
                                var latestHref = SiteRoutes.BuildMenuPath(latest.Url, lang);
                                <div class="latest-article" dir="@dir">
                                    <h4><a href="@latestHref">@latest.Name</a></h4>
                                    <a href="@latestHref" class="read-more">
                                        @T["ReadMore"]
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    <div class="sidebar-cta">
                        <span class="eyebrow eyebrow-light">@T["CtaEyebrow"]</span>
                        <h3>@T["CtaTitle"]</h3>
                        <a href="@contactHref" class="btn btn-primary">@T["ContactAlt"]</a>
                    </div>
                </aside>

            </div>
        </section>

    </main>

    <!-- ============== FOOTER ============== -->
    <footer class="site-footer">
        <div class="footer-top">

            <div class="footer-logo">
                <a href="@homePath" class="logo">
                    <img src="~/images/Logo.png" alt="@T["FirmName"]" class="logo-img">
                </a>
                <p>@T["FooterTagline"]</p>
            </div>

            <div class="footer-col">
                <h4>@T["FooterContact"]</h4>
                @if (!string.IsNullOrWhiteSpace(phoneDisplay))
                {
                    <a href="tel:@phoneDigits" class="contact-line">
                        <img src="~/images/phone.png" alt="" class="icon-img">
                        @phoneDisplay
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(whatsAppDigits))
                {
                    <a href="https://wa.me/@whatsAppDigits" target="_blank" rel="noopener" class="contact-line">
                        <img src="~/images/whatsapp.png" alt="" class="icon-img">
                        @T["WhatsApp"]
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <a href="mailto:@email" class="contact-line">
                        <img src="~/images/email.png" alt="" class="icon-img">
                        @email
                    </a>
                }
            </div>

        </div>

        <div class="footer-bottom">
            <p>@T["Copyright", DateTime.UtcNow.Year]</p>
            <p class="footer-legal">
                <a href="@privacyPath">@T["PrivacyPolicy"]</a>
                <span aria-hidden="true"> | </span>
                <a href="@termsPath">@T["TermsOfUse"]</a>
            </p>
        </div>
    </footer>

    <script>
            const navToggle = document.getElementById('navToggle');
            const mainNav = document.getElementById('mainNav');
            if (navToggle && mainNav) {
              navToggle.addEventListener('click', () => {
                const isOpen = mainNav.classList.toggle('open');
                navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
              });

              mainNav.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => {
                  mainNav.classList.remove('open');
                  navToggle.setAttribute('aria-expanded', 'false');
                });
              });
            }
    </script>

</body>
</html>
