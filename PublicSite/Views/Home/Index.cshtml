@model Models.PublicSite.HomePage
@{
    Layout = null;

    var contact = Model.ContactInfo;
    var dir = WritingDirection.GetHtmlDir(Model.CurrentLanguage.Code);
    var lang = Model.CurrentLanguage.Code;

    string DigitsOnly(string? value) => string.Concat((value ?? string.Empty).Where(char.IsDigit));

    var phoneDigits = DigitsOnly(contact?.Phone);
    var whatsAppDigits = DigitsOnly(contact?.WhatsApp);
    var email = contact?.Email;
    var phoneDisplay = contact?.Phone;
    var pageTitle = Model.SeoTitle ?? Model.HeroTitle;
    var homePath = SiteRoutes.BuildMenuPath("/", lang);
    var privacyPath = SiteRoutes.BuildPrivacyPolicyPath(lang);
    var termsPath = SiteRoutes.BuildTermsOfUsePath(lang);
    var contactPostPath = string.IsNullOrWhiteSpace(lang) ? "/Home/Contact" : $"/Home/Contact/{lang}";

    var featureRow1 = Model.Features.Take(3).ToList();
    var featureRow2 = Model.Features.Skip(3).ToList();
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
    {
        <meta name="description" content="@Model.MetaDescription">
    }
    @if (!string.IsNullOrWhiteSpace(Model.MetaRobots))
    {
        <meta name="robots" content="@Model.MetaRobots">
    }
    @if (!string.IsNullOrWhiteSpace(Model.OgTitle))
    {
        <meta property="og:title" content="@Model.OgTitle">
    }
    @if (!string.IsNullOrWhiteSpace(Model.OgDescription))
    {
        <meta property="og:description" content="@Model.OgDescription">
    }
    @if (!string.IsNullOrWhiteSpace(Model.OgImage))
    {
        <meta property="og:image" content="@Model.OgImage">
    }
    @if (!string.IsNullOrWhiteSpace(Model.OgType))
    {
        <meta property="og:type" content="@Model.OgType">
    }
    @if (!string.IsNullOrWhiteSpace(Model.OgUrl))
    {
        <meta property="og:url" content="@Model.OgUrl">
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/Styles/StyleSheetRTL.css" rel="stylesheet" />
</head>
<body>

    <div class="site-sticky">
    <!-- ============== TOP BAR ============== -->
    <div class="topbar">
        <div class="topbar-inner">
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <a href="mailto:@email" class="topbar-item" title="@email">
                    <img src="~/images/email.png" alt="" class="icon-img">
                    <span class="label">@email</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(phoneDisplay))
            {
                <a href="tel:@phoneDigits" class="topbar-item" title="@phoneDisplay">
                    <img src="~/images/phone.png" alt="" class="icon-img">
                    <span class="label">@phoneDisplay</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(whatsAppDigits))
            {
                <a href="https://wa.me/@whatsAppDigits" target="_blank" rel="noopener" class="topbar-item" title="@T["WhatsApp"]">
                    <img src="~/images/whatsapp.png" alt="" class="icon-img">
                    <span class="label">@T["WhatsApp"]</span>
                </a>
            }
        </div>
    </div>

    <!-- ============== HEADER ============== -->
    <header class="site-header">
        <div class="header-inner">
            <a href="@homePath" class="logo">
                <img src="~/images/Logo.png" alt="@T["FirmName"]" class="logo-img">
            </a>

            <nav class="main-nav" id="mainNav">
                <ul>
                    @foreach (var item in Model.Menu.Items.Reverse())
                    {
                        var hasSubMenu = item.SubMenu.Count > 0;
                        var isActive = SiteRoutes.IsHomeUrl(item.Url);
                        <li class="@(hasSubMenu ? "has-dropdown" : null)">
                            @if (hasSubMenu)
                            {
                                <span class="nav-parent">
                                    @item.Title
                                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                                </span>
                            }
                            else
                            {
                                <a href="@SiteRoutes.BuildMenuPath(item.Url, lang)"
                                   class="@(isActive ? "active" : null)">
                                    @item.Title
                                </a>
                            }
                            @if (hasSubMenu)
                            {
                                <ul class="dropdown">
                                    @foreach (var subItem in item.SubMenu)
                                    {
                                        <li>
                                            <a href="@SiteRoutes.BuildMenuPath(subItem.Url, lang)">
                                                @subItem.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </nav>

            <a href="#contact" class="btn btn-primary">@T["Contact"]</a>

            <button class="nav-toggle" id="navToggle" aria-label="@T["OpenMenu"]" aria-expanded="false" aria-controls="mainNav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
        </div>
    </header>
    </div>

    <main>

        <!-- ============== HERO ============== -->
        <section class="hero">
            <div class="hero-inner hero-load-in">
                @if (!string.IsNullOrWhiteSpace(Model.HeroEyebrow))
                {
                    <span class="eyebrow eyebrow-light">@Model.HeroEyebrow</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.HeroTitle))
                {
                    <h1>@Html.Raw(Model.HeroTitle)</h1>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PageText))
                {
                    <p>@Html.Raw(Model.PageText)</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.HeroCtaText))
                {
                    <div class="hero-cta">
                        <a href="@(Model.HeroCtaUrl ?? "#contact")" class="btn btn-primary">@Model.HeroCtaText</a>
                    </div>
                }
            </div>

            <div class="feature-cards">
                @if (featureRow1.Count > 0)
                {
                    <div class="feature-row feature-row-3">
                        @for (var i = 0; i < featureRow1.Count; i++)
                        {
                            var feature = featureRow1[i];
                            <article class="feature-card reveal">
                                @if (!string.IsNullOrWhiteSpace(feature.ImageUrl))
                                {
                                    <div class="feature-icon">
                                        <img src="@Url.Content("~" + feature.ImageUrl)" alt="" class="icon-img">
                                    </div>
                                }
                                @Html.Raw(feature.Text)
                            </article>
                        }
                    </div>
                }
                @if (featureRow2.Count > 0)
                {
                    <div class="feature-row feature-row-2">
                        @foreach (var feature in featureRow2)
                        {
                            <article class="feature-card reveal">
                                @if (!string.IsNullOrWhiteSpace(feature.ImageUrl))
                                {
                                    <div class="feature-icon">
                                        <img src="@Url.Content("~" + feature.ImageUrl)" alt="" class="icon-img">
                                    </div>
                                }
                                @Html.Raw(feature.Text)
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- ============== STRIP BANNER ============== -->
        @if (!string.IsNullOrWhiteSpace(Model.StripBannerText))
        {
            <section class="strip-banner reveal">
                <p>@Html.Raw(Model.StripBannerText)</p>
            </section>
        }

        <!-- ============== PRACTICE AREAS ============== -->
        @if (Model.PracticeAreas.Count > 0)
        {
            <section class="practice-areas" id="practice">
                <div class="container">
                    <div class="section-head reveal">
                        <span class="eyebrow">@T["PracticeAreas"]</span>
                        <h2>@T["HomePracticeHeading"]</h2>
                    </div>

                    <div class="practice-grid">
                        @foreach (var area in Model.PracticeAreas)
                        {
                            <a href="@SiteRoutes.BuildMenuPath(area.Url, lang)" class="practice-box reveal">
                                <div class="practice-box-main">
                                    @if (!string.IsNullOrWhiteSpace(area.IconUrl))
                                    {
                                        <img src="@Url.Content("~" + area.IconUrl)" alt="" class="practice-box-icon">
                                    }
                                    <div class="practice-box-text">
                                        <h3>@area.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(area.Summary))
                                        {
                                            <p>@area.Summary</p>
                                        }
                                    </div>
                                </div>
                                <span class="box-arrow">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
                                </span>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ============== CTA BANNER ============== -->
        <section class="cta-banner reveal">
            <span class="eyebrow eyebrow-light">@T["CtaEyebrow"]</span>
            <h2>@T["CtaTitle"]</h2>
            <p>@T["HomeCtaText"]</p>
            <a href="#contact" class="btn btn-primary">@T["ContactAlt"]</a>
        </section>

        <!-- ============== CONTACT FORM ============== -->
        <section class="contact-section">
            <div class="container" id="contact">
                <div class="section-head reveal">
                    <span class="eyebrow">@T["FooterContact"]</span>
                    <h2>@T["HomeContactTitle"]</h2>
                    <p>@T["HomeContactLead"]</p>
                </div>

                <form class="contact-form reveal" id="contactForm" method="post" action="@contactPostPath">
                    @Html.AntiForgeryToken()
                    <p class="contact-form-status" id="contactFormStatus" hidden
                       data-ok="@Localizer["ContactSent"].Value"
                       data-error="@Localizer["ContactError"].Value"
                       aria-live="polite"></p>
                    <input type="text" name="FullName" placeholder="@Localizer["PlaceholderFullName"]" required maxlength="200">
                    <div class="form-row">
                        <input type="tel" name="Phone" placeholder="@Localizer["PlaceholderPhone"]" required maxlength="50">
                        <input type="email" name="Email" placeholder="@Localizer["PlaceholderEmail"]" required maxlength="200">
                    </div>
                    <textarea name="Message" placeholder="@Localizer["PlaceholderMessage"]" maxlength="8000"></textarea>
                    <p class="contact-consent-notice">@Localizer["SmsConsentNotice", privacyPath, termsPath]</p>
                    <label class="contact-consent" for="contactConsent">
                        <input type="checkbox" id="contactConsent" name="consent" value="true" required>
                        <span>@Localizer["ConsentCheckbox"]</span>
                    </label>
                    <button type="submit" class="btn btn-primary btn-block" id="contactSubmit">@T["Contact"]</button>
                </form>
            </div>
        </section>

        <!-- ============== BLOG ============== -->
        @if (Model.FeaturedBlogs.Count > 0)
        {
            <section class="blog-section">
                <div class="container">
                    <div class="section-head reveal">
                        <span class="eyebrow">@T["BlogEyebrow"]</span>
                        <h2>@T["BlogHeading"]</h2>
                        <p class="sub-en">@T["BlogSub"]</p>
                    </div>

                    <div class="blog-grid">
                        @foreach (var post in Model.FeaturedBlogs)
                        {
                            <article class="blog-card reveal" dir="@dir">
                                <div class="blog-image">
                                    @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                                    {
                                        <img src="@Url.Content("~/images/blog/" + post.ImageUrl)" alt="@post.Name">
                                    }
                                </div>
                                <h3>@post.Name</h3>
                                <a href="@SiteRoutes.BuildMenuPath(post.Url, lang)" class="read-more">
                                    @T["ReadMore"]
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
                                </a>
                            </article>
                        }
                    </div>
                </div>
            </section>
        }

    </main>

    <!-- ============== FOOTER ============== -->
    <footer class="site-footer">
        <div class="footer-top">

            <div class="footer-logo">
                <a href="@homePath" class="logo">
                    <img src="~/images/Logo.png" alt="@T["FirmName"]" class="logo-img">
                </a>
                <p>@T["FooterTagline"]</p>
            </div>

            @if (Model.PracticeAreas.Count > 0)
            {
                <div class="footer-col">
                    <h4>@T["FooterPractice"]</h4>
                    <ul>
                        @foreach (var area in Model.PracticeAreas)
                        {
                            <li><a href="@SiteRoutes.BuildMenuPath(area.Url, lang)">@area.Name</a></li>
                        }
                    </ul>
                </div>
            }

            <div class="footer-col">
                <h4>@T["FooterContact"]</h4>
                @if (!string.IsNullOrWhiteSpace(phoneDisplay))
                {
                    <a href="tel:@phoneDigits" class="contact-line">
                        <img src="~/images/phone.png" alt="" class="icon-img">
                        @phoneDisplay
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(whatsAppDigits))
                {
                    <a href="https://wa.me/@whatsAppDigits" target="_blank" rel="noopener" class="contact-line">
                        <img src="~/images/whatsapp.png" alt="" class="icon-img">
                        @T["WhatsApp"]
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <a href="mailto:@email" class="contact-line">
                        <img src="~/images/email.png" alt="" class="icon-img">
                        @email
                    </a>
                }
            </div>

        </div>

        <div class="footer-bottom">
            <p>@T["Copyright", DateTime.UtcNow.Year]</p>
            <p class="footer-legal">
                <a href="@privacyPath">@T["PrivacyPolicy"]</a>
                <span aria-hidden="true"> | </span>
                <a href="@termsPath">@T["TermsOfUse"]</a>
            </p>
        </div>
    </footer>

    <script>
            const navToggle = document.getElementById('navToggle');
            const mainNav = document.getElementById('mainNav');
            if (navToggle && mainNav) {
              navToggle.addEventListener('click', () => {
                const isOpen = mainNav.classList.toggle('open');
                navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
              });

              mainNav.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => {
                  mainNav.classList.remove('open');
                  navToggle.setAttribute('aria-expanded', 'false');
                });
              });
            }
    </script>
    <script src="~/js/reveal.js"></script>
    <script>
            const sticky = document.querySelector('.site-sticky');
            if (sticky) {
              const syncStickyOffset = () => {
                document.documentElement.style.setProperty(
                  '--site-sticky-height',
                  `${Math.ceil(sticky.getBoundingClientRect().height)}px`
                );
              };
              syncStickyOffset();
              window.addEventListener('resize', syncStickyOffset);
            }

            const contactForm = document.getElementById('contactForm');
            const contactStatus = document.getElementById('contactFormStatus');
            const contactSubmit = document.getElementById('contactSubmit');
            if (contactForm && contactStatus && contactSubmit) {
              contactForm.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (!contactForm.checkValidity()) {
                  contactForm.reportValidity();
                  return;
                }

                contactStatus.hidden = true;
                contactSubmit.disabled = true;

                try {
                  const response = await fetch(contactForm.action, {
                    method: 'POST',
                    body: new FormData(contactForm),
                    headers: {
                      'Accept': 'application/json',
                      'X-Requested-With': 'XMLHttpRequest'
                    }
                  });
                  const data = await response.json().catch(() => ({ ok: false }));
                  const succeeded = response.ok && data && data.ok === true;
                  contactStatus.textContent = succeeded ? contactStatus.dataset.ok : contactStatus.dataset.error;
                  contactStatus.className = succeeded
                    ? 'contact-form-status contact-form-status--ok'
                    : 'contact-form-status contact-form-status--error';
                  contactStatus.hidden = false;
                  if (succeeded) {
                    contactForm.reset();
                  }
                } catch {
                  contactStatus.textContent = contactStatus.dataset.error;
                  contactStatus.className = 'contact-form-status contact-form-status--error';
                  contactStatus.hidden = false;
                } finally {
                  contactSubmit.disabled = false;
                }
              });
            }
    </script>
</body>
</html>
