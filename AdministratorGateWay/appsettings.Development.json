{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "AdministratorGateWay"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10
        }
      }
    ]
  },
  "DatabaseConnection": {
    "ConnectionString": "Data Source=DESKTOP-F3PP8GH\\MSSQL2019EXPRESS;Initial Catalog=EliSolutionDB;User ID=sa;Password=stasmylove;Trust Server Certificate=True"
  },
  "AdministratorDatabaseConnection": {
    "ConnectionString": "Data Source=DESKTOP-F3PP8GH\\MSSQL2019EXPRESS;Initial Catalog=EliAuthDB;User ID=sa;Password=stasmylove;Trust Server Certificate=True"
  },
  "Jwt": {
    "Issuer": "EliSolution.AdministratorGateWay",
    "Audience": "EliSolution.AdministratorFront",
    "SigningKey": "DevOnly-EliAuth-SigningKey-ChangeMe-32+",
    "AccessTokenHours": 8
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  }
}
